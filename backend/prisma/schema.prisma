// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())

  properties Property[]
}

model Property {
  id        Int            @id @default(autoincrement())
  name      String
  address   String?
  status    PropertyStatus @default(AVAILABLE)
  createdAt DateTime       @default(now())

  userId Int
  user   User @relation(fields: [userId], references: [id])

  devices  Device[]
  sessions StaySession[]
  packages RentalPackage[]
}

enum PropertyStatus {
  AVAILABLE
  OCCUPIED
  INACTIVE
}

model Device {
  id        Int       @id @default(autoincrement())
  name      String
  type      String
  topic     String    @unique
  createdAt DateTime  @default(now())
  isActive  Boolean   @default(false)
  lastSeen  DateTime?

  //  NOVO: potência para simulação
  powerWatts Float?

  propertyId Int
  property   Property @relation(fields: [propertyId], references: [id])

  readings DeviceReading[]

  sessions StaySessionDevice[]
}

model DeviceReading {
  id        BigInt   @id @default(autoincrement())
  value     Float
  createdAt DateTime @default(now())

  deviceId Int
  device   Device @relation(fields: [deviceId], references: [id])

  @@index([deviceId, createdAt])
}

//
//  NOVO: PACOTES DE ALUGUEL
//
model RentalPackage {
  id        Int    @id @default(autoincrement())
  name      String
  basePrice Float

  // duração opcional
  durationDays  Int?
  durationHours Int?

  // franquia energética
  energyLimitKwh   Float?
  pricePerExtraKwh Float?

  // controle de dispositivos
  maxDevicesActive Int?

  createdAt DateTime @default(now())

  propertyId Int
  property   Property @relation(fields: [propertyId], references: [id])

  sessions StaySession[]
}

//
//  NOVO: SESSÃO DE ESTADIA
//
model StaySession {
  id Int @id @default(autoincrement())

  clientName String

  checkinAt  DateTime
  checkoutAt DateTime

  startedAt DateTime?
  endedAt   DateTime?

  status SessionStatus @default(SCHEDULED)

  //  consumo acumulado (pra não depender só de query)
  totalConsumptionKwh Float @default(0)

  //  resultado financeiro
  extraConsumptionKwh Float @default(0)
  extraCost           Float @default(0)

  createdAt DateTime @default(now())

  propertyId Int
  property   Property @relation(fields: [propertyId], references: [id])

  packageId Int?
  package   RentalPackage? @relation(fields: [packageId], references: [id])

  //  override manual (caso não use pacote)
  customEnergyLimitKwh   Float?
  customPricePerExtraKwh Float?

  //  dispositivos usados na sessão
  devices StaySessionDevice[]
}

//
//  ligação sessão <-> dispositivos
//
model StaySessionDevice {
  id Int @id @default(autoincrement())

  isAllowed Boolean @default(true)

  sessionId Int
  session   StaySession @relation(fields: [sessionId], references: [id])

  deviceId Int
  device   Device @relation(fields: [deviceId], references: [id])

  @@unique([sessionId, deviceId])
}

//
//  ENUM DE STATUS
//
enum SessionStatus {
  SCHEDULED
  ACTIVE
  FINISHED
  CANCELLED
}
